# Copy to .env and edit. Every value below is optional; these are the defaults.
# .env is gitignored. Never commit real certificate paths, keys or tokens.

# Host dashboard (refuses to bind anything except loopback)
HOST_BIND=127.0.0.1
HOST_PORT=8765
DEV_ORIGINS=                  # extra allowed origins for the Vite dev server, comma separated

# Speech to text: local whisper.cpp server
WHISPER_URL=http://127.0.0.1:8080/inference
WHISPER_MODEL_NAME=ggml-base.en
WHISPER_PROMPT=
VAD=auto                      # auto (Silero if available) | silero | energy

# Local models through Ollama
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen3:1.7b       # live scam checks
ASSISTANT_MODEL=qwen3:1.7b    # live private answers (gemma4:e2b on 16 GB+ Macs)
SUMMARY_MODEL=gemma4:e2b      # after-call summary and tasks (Gemma 4)
OLLAMA_TIMEOUT_S=45
LLM_WORKERS=1                 # keep equal to OLLAMA_NUM_PARALLEL
SAFETY_NUM_PREDICT=96

# Privacy: nothing is written to disk unless you turn it on
PERSIST_RAW_AUDIO=false
PERSIST_TRANSCRIPTS=false

# Live phone guest (scripts/setup_hotspot.sh or scripts/setup_tailscale.sh fill these)
GUEST_ENABLED=false
GUEST_BIND=                   # exact hotspot / Tailscale IP of the Mac, never 0.0.0.0
GUEST_PORT=8443
GUEST_PUBLIC_DOMAIN=
GUEST_TLS_CERT=               # path to the cert, never committed
GUEST_TLS_KEY=                # path to the key (chmod 600), never committed
GUEST_DEV_LOOPBACK=false      # tests only: let the guest app bind 127.0.0.1
